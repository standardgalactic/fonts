    <namerecord nameID="0" platformID="3" platEncID="1" langID="0x409">
      Copyright 2010-2022 The Amiri Project Authors (https://github.com/aliftype/amiri).
    </namerecord>
    <namerecord nameID="1" platformID="3" platEncID="1" langID="0x409">
      Amiri
    </namerecord>
    <namerecord nameID="2" platformID="3" platEncID="1" langID="0x409">
      Regular
    </namerecord>
    <namerecord nameID="3" platformID="3" platEncID="1" langID="0x409">
      1.002;ALIF;Amiri-Regular
    </namerecord>
    <namerecord nameID="4" platformID="3" platEncID="1" langID="0x409">
      Amiri Regular
    </namerecord>
    <namerecord nameID="5" platformID="3" platEncID="1" langID="0x409">
      Version 1.002
    </namerecord>
    <namerecord nameID="6" platformID="3" platEncID="1" langID="0x409">
      Amiri-Regular
    </namerecord>
    <namerecord nameID="8" platformID="3" platEncID="1" langID="0x409">
      Alif Type
    </namerecord>
    <namerecord nameID="9" platformID="3" platEncID="1" langID="0x409">
      Khaled Hosny
    </namerecord>
    <namerecord nameID="10" platformID="3" platEncID="1" langID="0x409">
      Amiri is a classical Arabic typeface in Naskh style for typesetting books and other running text. Its design is a revival of the beautiful typeface pioneered in early 20th century by Bulaq Press in Cairo, also known as Amiria Press, after which the font is named.
    </namerecord>
    <namerecord nameID="11" platformID="3" platEncID="1" langID="0x409">
      https://aliftype.com
    </namerecord>
    <namerecord nameID="12" platformID="3" platEncID="1" langID="0x409">
      https://aliftype.com/amiri
    </namerecord>
    <namerecord nameID="13" platformID="3" platEncID="1" langID="0x409">
      This Font Software is licensed under the SIL Open Font License, Version 1.1. This license is available with a FAQ at: https://openfontlicense.org
    </namerecord>
    <namerecord nameID="14" platformID="3" platEncID="1" langID="0x409">
      https://openfontlicense.org
    </namerecord>
    <namerecord nameID="19" platformID="3" platEncID="1" langID="0x409">
      صِفْ خَلْقَ خَوْدٍ كَمِثْلِ ٱلشَّمْسِ إِذْ بَزَغَتْ يَحْظَىٰ ٱلضَّجِيعُ بِهَا نَجْلَاءَ مِعْطَارِ.
    </namerecord>
    <namerecord nameID="256" platformID="3" platEncID="1" langID="0x409">
      Inverted Arabic comma
    </namerecord>
    <namerecord nameID="257" platformID="3" platEncID="1" langID="0x409">
      Disable curvilinear Kashida
    </namerecord>
    <namerecord nameID="258" platformID="3" platEncID="1" langID="0x409">
      No automatic vowel insertion above name of God
    </namerecord>
    <namerecord nameID="259" platformID="3" platEncID="1" langID="0x409">
      Low Baa dot following a Raa or Waw
    </namerecord>
    <namerecord nameID="260" platformID="3" platEncID="1" langID="0x409">
      Alternate medial Meem and final Alef combination
    </namerecord>
    <namerecord nameID="261" platformID="3" platEncID="1" langID="0x409">
      Localised @ and &amp; symbols
    </namerecord>
    <namerecord nameID="262" platformID="3" platEncID="1" langID="0x409">
      Alternate, more naskh-like, Gaf form
    </namerecord>
    <namerecord nameID="263" platformID="3" platEncID="1" langID="0x409">
      Kasra is placed below Shadda instead of base glyph
    </namerecord>
  </name>

